      "fontSize": 12.982478545444991,
      "fontFamily": 1,
      "text": "FRAGMENT GENERATOR\n\nfragments = guard(..., stream=True)\n\nfor result in fragments:\n    render(result.validated_output)\n\nResult class names can vary by version.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "zxcrk_WICoGUoA-nninFM",
      "originalText": "FRAGMENT GENERATOR\n\nfragments = guard(..., stream=True)\n\nfor result in fragments:\n    render(result.validated_output)\n\nResult class names can vary by version.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCW"
    },
    {
      "id": "5gSXnwVaeVHpzsa02B13k",
      "type": "text",
      "x": 7662.526306479376,
      "y": 8407.830534508359,
      "width": 280.3157043457031,
      "height": 194.73717818167486,
      "angle": 0,
      "strokeColor": "#1e1e1e",
