      "link": null,
      "locked": false,
      "fontSize": 12.982478545444991,
      "fontFamily": 1,
      "text": "VALIDATION BOUNDARIES\n\nPLAIN TEXT\nDefault: accumulate about a sentence.\nA custom chunking function may change this.\n\nSTRUCTURED JSON\nRecognize a complete / meaningful field,\nobject, or sub-schema fragment first.\n\nNever expose a fragment before its\nrelevant validation boundary passes.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "NdN1m9oeAa03s5xSfnlFY",
      "originalText": "VALIDATION BOUNDARIES\n\nPLAIN TEXT\nDefault: accumulate about a sentence.\nA custom chunking function may change this.\n\nSTRUCTURED JSON\nRecognize a complete / meaningful field,\nobject, or sub-schema fragment first.\n\nNever expose a fragment before its\nrelevant validation boundary passes.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "bCX"
    },
    {
      "id": "pDkSAfGWHurns8hv8ipDE",
      "type": "text",
      "x": 8202.808844552319,
      "y": 8407.830534508359,
      "width": 251.33139038085938,
      "height": 194.73717818167486,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
