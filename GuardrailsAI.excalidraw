      "link": null,
      "locked": false,
      "fontSize": 20,
      "fontFamily": 1,
      "text": "CAUTION\nRelease a chunk only after its relevant validation boundary passes.\nNot every on_fail / remediation action supports streaming.\nUnsupported modes must wait, buffer, or fall back to non-streaming behavior.",
      "textAlign": "center",
      "verticalAlign": "middle",
      "containerId": "qeyEmEhotR8-y18rF3GPd",
      "originalText": "CAUTION\nRelease a chunk only after its relevant validation boundary passes.\nNot every on_fail / remediation action supports streaming.\nUnsupported modes must wait, buffer, or fall back to non-streaming behavior.",
      "autoResize": true,
      "lineHeight": 1.25,
      "index": "b6a"
